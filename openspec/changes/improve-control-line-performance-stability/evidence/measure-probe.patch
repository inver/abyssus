+package net.nevinsky.abyssus.app.game.controlline
+
+import com.github.stephengold.joltjni.ConvexHullShapeSettings
+import com.github.stephengold.joltjni.HeightFieldShapeSettings
+import com.github.stephengold.joltjni.Vec3
+import net.nevinsky.abyssus.lib.core.assets.MetaType
+import net.nevinsky.abyssus.lib.core.ecs.component.assetName
+import net.nevinsky.abyssus.lib.physics.ColliderComponent
+import net.nevinsky.abyssus.lib.physics.PhysicsAssets
+import net.nevinsky.abyssus.lib.physics.jolt.JoltNatives
+import org.junit.Test
+import java.io.File
+
+class MeasureShapesTest {
+    @Test
+    fun shapes() {
+        JoltNatives().load()
+        val assets = PhysicsAssets(bundledProject().toFile())
+        val scene = loadField()
+        val out = StringBuilder()
+        for (e in scene.engine.entities) {
+            val c = e.getComponent(ColliderComponent::class.java) ?: continue
+            when (c.shape.name) {
+                "CONVEX_HULL" -> {
+                    val name = assetName(e, MetaType.MODEL)!!
+                    val t0 = System.nanoTime(); val pts = assets.modelPoints(name)!!; val read = (System.nanoTime() - t0) / 1e6
+                    val times = (1..3).map {
+                        val t = System.nanoTime(); val r = ConvexHullShapeSettings(pts.map { Vec3(it.x, it.y, it.z) }).create(); val ms = (System.nanoTime() - t) / 1e6
+                        check(!r.hasError()) { r.getError() }; ms
+                    }
+                    val unique = pts.map { Triple(it.x, it.y, it.z) }.toSet().size
+                    out.appendLine("hull %-40s points=%7d unique=%7d read=%.1f ms create=%s".format(name, pts.size, unique, read, times.map { "%.1f".format(it) }))
+                }
+                "HEIGHT_FIELD" -> {
+                    val name = assetName(e, MetaType.TERRAIN)!!
+                    val td = assets.terrain(name)!!
+                    val n = if (td.resolution % 2 == 0) td.resolution else td.resolution + 1
+                    val times = (1..3).map {
+                        val samples = FloatArray(n * n); for (z in 0 until td.resolution) for (x in 0 until td.resolution) samples[z * n + x] = td.heights[z * td.resolution + x]
+                        val t = System.nanoTime(); HeightFieldShapeSettings(samples, Vec3(0f, 0f, 0f), Vec3(1f, 1f, 1f), n).create(); (System.nanoTime() - t) / 1e6
+                    }
+                    out.appendLine("heightfield %s resolution=%d create=%s".format(name, td.resolution, times.map { "%.1f".format(it) }))
+                }
+            }
+        }
+        File("build/measure-shapes.txt").writeText(out.toString()); println(out)
+    }
+}
