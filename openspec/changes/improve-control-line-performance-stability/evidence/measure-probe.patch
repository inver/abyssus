@@ -0,0 +1,86 @@
+package net.nevinsky.abyssus.app.game.controlline.measure
+
+import com.badlogic.gdx.Gdx
+import com.badlogic.gdx.graphics.profiling.GLProfiler
+import org.lwjgl.opengl.GL15
+import org.lwjgl.opengl.GL33
+import java.lang.management.ManagementFactory
+
+/** Scratch measurement probe (worktree only, never committed). */
+object Probe {
+    val noCull = System.getProperty("measure.noCull") == "true"
+    val counters = System.getProperty("measure.counters") == "true"
+    var on = false
+    val spans = listOf("prep", "flight", "field.assets", "field.sky", "field.skylight", "field.shadow", "field.terrain", "field.models", "field.lines", "ui.update", "ui.draw")
+    private val n = spans.size
+    private const val RING = 8
+    private var queries: IntArray? = null
+    private var slot = 0
+    private val pending = ArrayDeque<Int>()
+    private var cursor = 0
+    private var last = 0L
+    private var start = 0L
+    private var allocStart = 0L
+    private val mx = ManagementFactory.getThreadMXBean() as com.sun.management.ThreadMXBean
+    private var profiler: GLProfiler? = null
+    private val cpu = LongArray(n)
+    private val spanAlloc = LongArray(n)
+    private var lastAlloc = 0L
+    private val calls = IntArray(n); private val switches = IntArray(n); private val binds = IntArray(n); private val verts = IntArray(n)
+    private var lastCalls = 0; private var lastSwitches = 0; private var lastBinds = 0; private var lastVerts = 0
+
+    class Frame(val total: Long, val cpu: LongArray, val alloc: Long, val spanAlloc: LongArray, val calls: IntArray, val switches: IntArray, val binds: IntArray, val verts: IntArray) { var gpu: LongArray? = null }
+    val frames = ArrayList<Frame>()
+    private val bySlot = arrayOfNulls<Frame>(RING)
+
+    fun begin() {
+        if (!on) return
+        if (queries == null) { queries = IntArray(RING * (n + 1)).also { GL15.glGenQueries(it) } }
+        if (counters && profiler == null) profiler = GLProfiler(Gdx.graphics).also { it.enable() }
+        poll()
+        if (pending.size >= RING) { pending.clear() } // never block: drop GPU data of a frame still in flight
+        cursor = 0
+        profiler?.reset(); lastCalls = 0; lastSwitches = 0; lastBinds = 0; lastVerts = 0
+        allocStart = mx.getThreadAllocatedBytes(Thread.currentThread().id)
+        start = System.nanoTime(); last = start; lastAlloc = allocStart
+        GL15.glBeginQuery(GL33.GL_TIME_ELAPSED, queries!![slot * (n + 1)])
+    }
+
+    fun mark(name: String) {
+        if (!on) return
+        val i = cursor
+        check(spans[i] == name) { "expected ${spans[i]}, got $name" }
+        val now = System.nanoTime(); cpu[i] = now - last; last = now
+        val a = mx.getThreadAllocatedBytes(Thread.currentThread().id); spanAlloc[i] = a - lastAlloc; lastAlloc = a
+        profiler?.let { p ->
+            val c = p.drawCalls; val s = p.shaderSwitches; val b = p.textureBindings; val v = p.vertexCount.total.toInt()
+            calls[i] = c - lastCalls; switches[i] = s - lastSwitches; binds[i] = b - lastBinds; verts[i] = v - lastVerts
+            lastCalls = c; lastSwitches = s; lastBinds = b; lastVerts = v
+        }
+        GL15.glEndQuery(GL33.GL_TIME_ELAPSED)
+        if (i + 1 < n) GL15.glBeginQuery(GL33.GL_TIME_ELAPSED, queries!![slot * (n + 1) + i + 1])
+        cursor++
+    }
+
+    /** Skips the marks a frame did not reach (no session, no lines) so the indices line up. */
+    fun skipTo(name: String) { if (!on) return; while (spans[cursor] != name) mark(spans[cursor]) }
+
+    fun end() {
+        if (!on) return
+        while (cursor < n) mark(spans[cursor])
+        val f = Frame(System.nanoTime() - start, cpu.copyOf(), mx.getThreadAllocatedBytes(Thread.currentThread().id) - allocStart, spanAlloc.copyOf(), calls.copyOf(), switches.copyOf(), binds.copyOf(), verts.copyOf())
+        frames += f; bySlot[slot] = f; pending.addLast(slot)
+        slot = (slot + 1) % RING
+    }
+
+    private fun poll() {
+        val q = queries ?: return
+        while (pending.isNotEmpty()) {
+            val s = pending.first()
+            val lastQ = q[s * (n + 1) + n - 1]
+            if (GL15.glGetQueryObjecti(lastQ, GL15.GL_QUERY_RESULT_AVAILABLE) == 0) return
+            pending.removeFirst()
+            bySlot[s]?.gpu = LongArray(n) { GL33.glGetQueryObjecti64(q[s * (n + 1) + it], GL15.GL_QUERY_RESULT) }
+        }
+    }
+}
