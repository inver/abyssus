+package net.nevinsky.abyssus.app.game.controlline
+
+import net.nevinsky.abyssus.app.game.controlline.ai.f2bBot
+import net.nevinsky.abyssus.app.game.controlline.components.PlaneComponent
+import net.nevinsky.abyssus.app.game.controlline.flight.FlightControlSource
+import net.nevinsky.abyssus.app.game.controlline.flight.FlightEnd
+import net.nevinsky.abyssus.app.game.controlline.flight.FlightJudge
+import net.nevinsky.abyssus.app.game.controlline.flight.FlightSession
+import net.nevinsky.abyssus.app.game.controlline.track.TrackSample
+import net.nevinsky.abyssus.app.game.controlline.flow.Mode
+import net.nevinsky.abyssus.app.game.controlline.flow.reportOf
+import net.nevinsky.abyssus.app.game.controlline.pattern.AssistLevel
+import net.nevinsky.abyssus.app.game.controlline.pattern.PatternJudge
+import net.nevinsky.abyssus.app.game.controlline.render.FieldScene
+import net.nevinsky.abyssus.lib.physics.PhysicsAssets
+import net.nevinsky.abyssus.lib.physics.RigidBodyComponent
+import net.nevinsky.abyssus.lib.physics.jolt.JoltNatives
+import net.nevinsky.abyssus.lib.gdx.testing.failOnWarnings
+import org.junit.Test
+import java.io.File
+import java.lang.management.ManagementFactory
+
+/** Scratch measurement (not for the repo): headless costs of scene load, flight start and a Watch AI F2B flight. */
+class MeasureHeadlessTest {
+    private val mx = ManagementFactory.getThreadMXBean() as com.sun.management.ThreadMXBean
+    private val tid = Thread.currentThread().id
+    private fun alloc() = mx.getThreadAllocatedBytes(Thread.currentThread().id)
+
+    private fun pct(xs: List<Double>, p: Double): Double = xs.sorted().let { it[((it.size - 1) * p).toInt()] }
+    private fun row(name: String, xs: List<Double>) =
+        "%-28s n=%6d p50=%8.3f p95=%8.3f p99=%8.3f max=%8.3f mean=%8.3f".format(name, xs.size, pct(xs, .5), pct(xs, .95), pct(xs, .99), xs.max(), xs.average())
+
+    @Test
+    fun measure() {
+        val out = StringBuilder()
+        val natives = JoltNatives()
+        val assets = { PhysicsAssets(bundledProject().toFile()) }
+        // scene load as FlightRunner.start / debriefSceneOf do it (document read, bind, ECS build, FieldScene listing)
+        val loads = ArrayList<Double>()
+        val loadAlloc = ArrayList<Double>()
+        repeat(8) {
+            val a = alloc(); val t = System.nanoTime()
+            FieldScene(loadField())
+            loads += (System.nanoTime() - t) / 1e6; loadAlloc += (alloc() - a) / 1e6
+        }
+        out.appendLine("scene load ms (first is cold): ${loads.map { "%.1f".format(it) }}")
+        out.appendLine("scene load MB allocated: ${loadAlloc.map { "%.1f".format(it) }}")
+
+        // physics world + session build (the rest of FlightRunner.start), and close
+        val builds = ArrayList<Double>(); val closes = ArrayList<Double>()
+        repeat(8) {
+            val scene = FieldScene(loadField())
+            val plane = scene.planes.first { it.name == "Stunter" }.let { scene.entity(it.entityId)!! }
+            val pilot = scene.pilot!!
+            val t = System.nanoTime()
+            val s = FlightSession(scene.engine, pilot, plane, assets(), failOnWarnings(), natives)
+            builds += (System.nanoTime() - t) / 1e6
+            val c = System.nanoTime(); s.close(); closes += (System.nanoTime() - c) / 1e6
+        }
+        out.appendLine("session build ms (first is cold, includes Jolt load): ${builds.map { "%.1f".format(it) }}")
+        out.appendLine("session close ms: ${closes.map { "%.1f".format(it) }}")
+        // the same with one PhysicsAssets kept across flights, and the parts of a build
+        val shared = assets()
+        val sharedBuilds = ArrayList<Double>(); val assetRead = ArrayList<Double>()
+        repeat(6) {
+            val scene = FieldScene(loadField())
+            val plane = scene.planes.first { it.name == "Stunter" }.let { scene.entity(it.entityId)!! }
+            val t = System.nanoTime()
+            val s = FlightSession(scene.engine, scene.pilot!!, plane, shared, failOnWarnings(), natives)
+            sharedBuilds += (System.nanoTime() - t) / 1e6
+            s.close()
+        }
+        out.appendLine("session build ms, shared PhysicsAssets: ${sharedBuilds.map { "%.1f".format(it) }}")
+        repeat(3) {
+            val fresh = assets(); val scene = FieldScene(loadField())
+            val t = System.nanoTime()
+            val w = net.nevinsky.abyssus.lib.physics.jolt.PhysicsWorld(scene.engine, fresh, failOnWarnings(), natives)
+            assetRead += (System.nanoTime() - t) / 1e6
+            w.close()
+        }
+        out.appendLine("PhysicsWorld alone ms, fresh PhysicsAssets: ${assetRead.map { "%.1f".format(it) }}")
+
+        // a whole Watch AI F2B flight at 60 frames a second
+        val scene = FieldScene(loadField())
+        val planeEntity = scene.planes.first { it.name == "Stunter" }.let { scene.entity(it.entityId)!! }
+        val settings = planeEntity.getComponent(PlaneComponent::class.java)
+        val mass = planeEntity.getComponent(RigidBodyComponent::class.java).mass
+        val judge = PatternJudge(settings.lineLength)
+        val bot = f2bBot(settings, mass, judge::guideInput)
+        val judgeMs = ArrayList<Double>(); val botMs = ArrayList<Double>()
+        val timedJudge = object : FlightJudge {
+            override fun sample(sample: TrackSample) { val t = System.nanoTime(); judge.sample(sample); judgeMs += (System.nanoTime() - t) / 1e6 }
+            override fun ended(end: FlightEnd) { val t = System.nanoTime(); judge.ended(end); out.appendLine("judge.ended ms: %.3f".format((System.nanoTime() - t) / 1e6)) }
+        }
+        val control = FlightControlSource { o -> val t = System.nanoTime(); bot.tilt(o).also { botMs += (System.nanoTime() - t) / 1e6 } }
+        val session = FlightSession(scene.engine, scene.pilot!!, planeEntity, assets(), failOnWarnings(), natives, timedJudge, control)
+        val frameMs = ArrayList<Double>(); val frameAlloc = ArrayList<Double>(); val wiresMs = ArrayList<Double>()
+        val gcBefore = ManagementFactory.getGarbageCollectorMXBeans().sumOf { it.collectionCount }
+        while (session.flight.result == null && session.flight.time < 430f) {
+            val a = alloc(); val t = System.nanoTime()
+            session.advance(1f / 60f)
+            val w = System.nanoTime()
+            session.wires(1f / 60f)
+            val e = System.nanoTime()
+            frameMs += (w - t) / 1e6; wiresMs += (e - w) / 1e6; frameAlloc += (alloc() - a).toDouble()
+        }
+        val gcAfter = ManagementFactory.getGarbageCollectorMXBeans().sumOf { it.collectionCount }
+        out.appendLine("flight: ${session.flight.result} after %.1f s, ${frameMs.size} frames, GCs %d".format(session.flight.time, gcAfter - gcBefore))
+        val steady = frameMs.drop(600)
+        out.appendLine(row("advance per frame ms", steady))
+        out.appendLine(row("wires per frame ms", wiresMs.drop(600)))
+        out.appendLine(row("judge.sample per step ms", judgeMs.drop(1200)))
+        out.appendLine(row("bot.tilt per step ms", botMs.drop(1200)))
+        out.appendLine(row("flight alloc per frame KB", frameAlloc.drop(600).map { it / 1024 }))
+        // judge cost over time: the first and last minute of samples
+        out.appendLine(row("judge.sample first 60 s", judgeMs.drop(1200).take(7200)))
+        out.appendLine(row("judge.sample last 60 s", judgeMs.takeLast(7200)))
+        val top = judgeMs.withIndex().sortedByDescending { it.value }.take(8).map { "%.2f ms @ %.1f s".format(it.value, it.index / 120f) }
+        out.appendLine("slowest judge samples: $top")
+        val t = System.nanoTime()
+        val report = reportOf(session, Mode.Pattern(AssistLevel.values().first()), judge, "Stunter")
+        out.appendLine("reportOf ms: %.3f (report ${report != null})".format((System.nanoTime() - t) / 1e6))
+        session.close()
+        val file = File(System.getProperty("measure.out", "build/measure-headless.txt"))
+        file.parentFile.mkdirs(); file.writeText(out.toString())
+        println(out)
+    }
+}
