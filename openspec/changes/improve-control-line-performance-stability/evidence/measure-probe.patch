+package net.nevinsky.abyssus.app.game.controlline.measure
+
+import com.badlogic.gdx.ApplicationListener
+import com.badlogic.gdx.Gdx
+import com.badlogic.gdx.graphics.GL20
+import com.badlogic.gdx.backends.lwjgl3.Lwjgl3Application
+import com.badlogic.gdx.backends.lwjgl3.Lwjgl3ApplicationConfiguration
+import net.nevinsky.abyssus.app.game.controlline.ControlLineGame
+import net.nevinsky.abyssus.app.game.controlline.flow.Screen
+import net.nevinsky.abyssus.app.game.controlline.pattern.AssistLevel
+import java.io.File
+import java.lang.management.ManagementFactory
+import java.nio.file.Files
+import java.nio.file.Path
+
+/** Scratch measurement driver: the real game, scripted through its flow, timed by [Probe]. */
+fun main() {
+    val project = Path.of(System.getProperty("controlLine.project")).toAbsolutePath()
+    val home = Files.createTempDirectory("cl-measure")
+    val config = Lwjgl3ApplicationConfiguration().apply {
+        setTitle("Control Line (measure)"); setWindowedMode(1280, 720); setWindowPosition(40, 40)
+        useVsync(false); setForegroundFPS(60)
+        setBackBufferConfig(8, 8, 8, 8, 24, 0, 4)
+        setOpenGLEmulation(Lwjgl3ApplicationConfiguration.GLEmulation.GL30, 3, 3)
+    }
+    val game = ControlLineGame(project, home.resolve("scores.json"))
+    Lwjgl3Application(Script(game), config)
+}
+
+private class Script(val game: ControlLineGame) : ApplicationListener {
+    var frame = 0
+    val marks = ArrayList<Pair<String, IntRange>>() // phase name -> frame indices in Probe.frames
+    var phase: String? = null; var phaseStart = 0
+    var starts = 0
+    var next = 0
+    val out = StringBuilder()
+    val gcBean = ManagementFactory.getGarbageCollectorMXBeans()
+    var gcAt = 0L; var gcMsAt = 0L
+
+    override fun create() {
+        game.create()
+        out.appendLine("GL_RENDERER=${Gdx.gl.glGetString(GL20.GL_RENDERER)} GL_VERSION=${Gdx.gl.glGetString(GL20.GL_VERSION)}")
+        out.appendLine("backBuffer=${Gdx.graphics.backBufferWidth}x${Gdx.graphics.backBufferHeight} logical=${Gdx.graphics.width}x${Gdx.graphics.height} clouds=${System.getProperty("measure.clouds")}")
+        out.appendLine("JVM=${System.getProperty("java.vendor")} ${System.getProperty("java.version")} maxHeap=${Runtime.getRuntime().maxMemory() / 1048576} MB noCull=${Probe.noCull} counters=${Probe.counters}")
+        Probe.on = true
+    }
+    override fun resize(width: Int, height: Int) = game.resize(width, height)
+    override fun pause() = game.pause()
+    override fun resume() = game.resume()
+    override fun dispose() = game.dispose()
+
+    fun open(name: String) { phase = name; phaseStart = Probe.frames.size; gcAt = gcBean.sumOf { it.collectionCount }; gcMsAt = gcBean.sumOf { it.collectionTime } }
+    fun close() { marks += phase!! to (phaseStart until Probe.frames.size); out.appendLine("phase $phase GCs=${gcBean.sumOf { it.collectionCount } - gcAt} gcMs=${gcBean.sumOf { it.collectionTime } - gcMsAt}"); phase = null }
+
+    override fun render() {
+        val flow = game.flow
+        // script, in frames at 60 a second
+        when {
+            frame == 600 -> open("menu")
+            frame == 1200 -> { close(); flow.f2bPattern(); flow.chooseAssist(AssistLevel.MID); flow.watchAi(); open("start1") }
+            frame == 1201 -> { close(); open("after-start1") }
+            frame == 1260 -> close()
+            frame == 1200 + 1200 -> open("flying")       // 20 s into the flight
+            frame == 1200 + 1200 + 3600 -> { close(); flow.pause(); flow.mainMenu(); open("return1") }
+            frame == 6001 -> { close(); open("after-return1") }
+            frame == 6060 -> { close(); next = 6200 }
+            next in 1..frame && starts < 5 -> {
+                starts++
+                flow.f2bPattern(); flow.chooseAssist(AssistLevel.MID); flow.watchAi(); open("start${starts + 1}")
+                next = -frame
+            }
+            next < 0 && frame == -next + 1 -> close()
+            next < 0 && frame == -next + 180 -> { flow.pause(); flow.mainMenu(); open("return${starts + 1}") }
+            next < 0 && frame == -next + 181 -> { close(); next = frame + 120 }
+            starts >= 5 && next in 1..frame -> { report(); Gdx.app.exit() }
+        }
+        game.render()
+        frame++
+    }
+
+    fun pct(xs: List<Double>, p: Double) = if (xs.isEmpty()) Double.NaN else xs.sorted()[((xs.size - 1) * p).toInt()]
+    fun row(name: String, xs: List<Double>) = "  %-14s p50=%7.3f p95=%7.3f p99=%7.3f max=%8.3f mean=%7.3f".format(name, pct(xs, .5), pct(xs, .95), pct(xs, .99), xs.maxOrNull() ?: Double.NaN, xs.average())
+
+    fun report() {
+        for ((name, range) in marks) {
+            val fs = range.map { Probe.frames[it] }
+            if (fs.isEmpty()) continue
+            out.appendLine("== $name frames=${fs.size}")
+            out.appendLine(row("cpu frame ms", fs.map { it.total / 1e6 }))
+            Probe.spans.forEachIndexed { i, s -> out.appendLine(row("cpu $s", fs.map { it.cpu[i] / 1e6 })) }
+            val g = fs.mapNotNull { it.gpu }
+            out.appendLine("  gpu frames with results: ${g.size}")
+            if (g.isNotEmpty()) {
+                out.appendLine(row("gpu frame ms", g.map { it.sum() / 1e6 }))
+                Probe.spans.forEachIndexed { i, s -> out.appendLine(row("gpu $s", g.map { it[i] / 1e6 })) }
+            }
+            out.appendLine(row("alloc KB", fs.map { it.alloc / 1024.0 }))
+            Probe.spans.forEachIndexed { i, s -> out.appendLine(row("allocKB $s", fs.map { it.spanAlloc[i] / 1024.0 })) }
+            if (Probe.counters) Probe.spans.forEachIndexed { i, s ->
+                out.appendLine("  counters %-14s calls=%.0f switches=%.0f binds=%.0f verts=%.0f".format(s, fs.map { it.calls[i] }.average(), fs.map { it.switches[i] }.average(), fs.map { it.binds[i] }.average(), fs.map { it.verts[i] }.average()))
+            }
+        }
+        val f = File(System.getProperty("measure.out")); f.parentFile.mkdirs(); f.writeText(out.toString())
+    }
+}
