<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>net.nevinsky.abyssus</id>
    <name>Abyssus - Libgdx Scene Editor</name>
    <vendor>inver</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.AbyssusBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="net.nevinsky.abyssus.toolWindow.MyToolWindowFactory" id="MyToolWindow"/>
        <fileType
                name="Gltf File"
                implementationClass="net.nevinsky.abyssus.language.GltfFileType"
                fieldName="INSTANCE"
                language="GLTF"
                extensions="gltf"/>
        <fileType
                name="Abyssus Scene"
                implementationClass="net.nevinsky.abyssus.filetype.SceneFileType"
                fieldName="INSTANCE"
                extensions="scene"/>
        <fileType
                name="Abyssus Project"
                implementationClass="net.nevinsky.abyssus.filetype.AbyssusProjectFileType"
                fieldName="INSTANCE"
                extensions="abss"/>
        <projectViewPane implementation="net.nevinsky.abyssus.projectView.AbyssusProjectViewPane"/>
        <lang.parserDefinition
                language="GLTF"
                implementationClass="net.nevinsky.abyssus.language.GltfParserDefinition"/>
    </extensions>

    <applicationListeners>
        <listener class="net.nevinsky.abyssus.listeners.MyFrameStateListener"
                  topic="com.intellij.ide.FrameStateListener"/>
    </applicationListeners>
</idea-plugin>
