{
  "version": 1,
  "components": [
    {
      "name": "PlaneComponent",
      "class": "net.nevinsky.abyssus.lib.runtime.schema.PlaneComponent",
      "label": "Plane",
      "fields": [
        {
          "name": "lineLength",
          "label": "Line length",
          "type": "decimal",
          "default": 18,
          "group": "Lines",
          "min": 5,
          "max": 30
        },
        {
          "name": "fuelSeconds",
          "label": "Fuel seconds",
          "type": "whole",
          "default": 60,
          "min": 0
        },
        {
          "name": "hasTipWeight",
          "label": "Tip weight",
          "type": "boolean",
          "default": true
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": ""
        },
        {
          "name": "kind",
          "label": "Kind",
          "type": "choice",
          "choices": ["TRAINER", "STUNT", "SPEED"],
          "default": "TRAINER"
        },
        {
          "name": "leadout",
          "label": "Leadout",
          "type": "vector",
          "default": {
            "x": 0,
            "y": 0,
            "z": -0.3
          },
          "group": "Lines"
        },
        {
          "name": "paint",
          "label": "Paint",
          "type": "color",
          "default": {
            "r": 1,
            "g": 1,
            "b": 1,
            "a": 1
          }
        },
        {
          "name": "pilot",
          "label": "Pilot",
          "type": "entity",
          "default": -1
        },
        {
          "name": "model",
          "label": "Model",
          "type": "asset",
          "assetType": "MODEL",
          "default": ""
        }
      ]
    }
  ]
}
