<idea-plugin>
    <id>net.nevinsky.abyssus.physics</id>
    <name>Abyssus Physics</name>
    <vendor>inver</vendor>
    <description>Physics for Abyssus scenes: collider and constraint overlays and Play in the Scene view.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>net.nevinsky.abyssus</depends>

    <resource-bundle>messages.AbyssusPhysicsBundle</resource-bundle>

    <extensions defaultExtensionNs="net.nevinsky.abyssus">
        <!-- generated at build time from net.nevinsky.abyssus.lib.physics.PhysicsComponents -->
        <componentSchemas resource="/schemas/physics.schema.json"/>
        <sceneOverlay implementation="net.nevinsky.abyssus.plugin.physics.PhysicsOverlayProvider"/>
        <sceneSimulation implementation="net.nevinsky.abyssus.plugin.physics.PhysicsSimulationProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Abyssus Physics" displayType="BALLOON" key="notification.group.Abyssus Physics"/>
    </extensions>

</idea-plugin>
