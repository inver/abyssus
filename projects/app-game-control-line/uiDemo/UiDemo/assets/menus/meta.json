{
  "format": "abyssus",
  "formatVersion": 1,
  "version": 1,
  "uuid": "0b1c0f5e-7a2e-4d0b-9a0a-3a1f6d6e2b11",
  "type": "UI",
  "additional": {
    "ui": {
      "schemaVersion": 1,
      "entryScreen": "main",
      "bindings": [
        { "name": "volume", "type": "number", "access": "write", "sample": 0.5, "min": 0, "max": 1, "step": 0.05 },
        { "name": "muted", "type": "boolean", "access": "write", "sample": false },
        { "name": "playerName", "type": "string", "access": "write", "sample": "Pilot", "maxLength": 12 },
        { "name": "health", "type": "number", "sample": 100 },
        { "name": "maxHealth", "type": "number", "sample": 100 },
        { "name": "score", "type": "number", "sample": 0 }
      ],
      "styles": [
        { "name": "title", "fontSize": 32, "color": "#ffd24aff" },
        { "name": "danger", "background": "#8a2b2bff", "states": { "hover": { "background": "#a53a3aff" } } }
      ],
      "screens": [
        {
          "id": "main", "name": "Main menu",
          "root": {
            "id": "main-root", "type": "column",
            "layout": { "anchor": "center", "spacing": 12, "align": "center" },
            "children": [
              { "id": "title", "type": "label", "style": "title", "properties": { "text": "UI demo" } },
              { "id": "name", "type": "textField", "layout": { "width": 240 }, "bindings": { "text": "playerName" } },
              { "id": "volume", "type": "slider", "layout": { "width": 240 }, "bindings": { "value": "volume" } },
              { "id": "muted", "type": "checkbox", "layout": { "width": 240 }, "properties": { "text": "Mute" }, "bindings": { "checked": "muted" } },
              { "id": "start", "type": "button", "layout": { "width": 240 }, "properties": { "text": "Start" },
                "actions": { "click": { "type": "emitAction", "name": "startGame" } } },
              { "id": "settings", "type": "button", "layout": { "width": 240 }, "properties": { "text": "Settings" },
                "actions": { "click": { "type": "openScreen", "screenId": "settings" } } },
              { "id": "quit", "type": "button", "style": "danger", "layout": { "width": 240 }, "properties": { "text": "Quit" },
                "actions": { "click": { "type": "emitAction", "name": "quit" } } }
            ]
          }
        },
        {
          "id": "settings", "name": "Settings",
          "root": {
            "id": "settings-root", "type": "column",
            "layout": { "anchor": "center", "spacing": 12, "align": "center" },
            "children": [
              { "id": "settings-title", "type": "label", "style": "title", "properties": { "text": "Settings" } },
              { "id": "settings-volume", "type": "slider", "layout": { "width": 240 }, "bindings": { "value": "volume" } },
              { "id": "settings-muted", "type": "checkbox", "layout": { "width": 240 }, "properties": { "text": "Mute" }, "bindings": { "checked": "muted" } },
              { "id": "back", "type": "button", "layout": { "width": 240 }, "properties": { "text": "Back" }, "actions": { "click": { "type": "back" } } }
            ]
          }
        },
        {
          "id": "hud", "name": "HUD", "kind": "overlay", "modal": false,
          "root": {
            "id": "hud-root", "type": "panel",
            "children": [
              { "id": "health-bar", "type": "progressBar", "layout": { "anchor": "topRight", "x": -16, "y": 16, "width": 240, "height": 18 },
                "bindings": { "value": "health", "maximum": "maxHealth" } },
              { "id": "score", "type": "label", "layout": { "anchor": "topLeft", "x": 16, "y": 16 },
                "properties": { "prefix": "Score ", "precision": 0 }, "bindings": { "text": "score" } },
              { "id": "pause-open", "type": "button", "layout": { "anchor": "bottomRight", "x": -16, "y": -16, "width": 120 },
                "properties": { "text": "Pause" }, "actions": { "click": { "type": "showOverlay", "screenId": "pause" } } }
            ]
          }
        },
        {
          "id": "pause", "name": "Pause", "kind": "overlay", "modal": true,
          "root": {
            "id": "pause-root", "type": "column",
            "layout": { "anchor": "center", "spacing": 12, "align": "center", "padding": 24 },
            "properties": { "styleOverrides": { "background": "#000000b0" } },
            "children": [
              { "id": "paused", "type": "label", "style": "title", "properties": { "text": "Paused" } },
              { "id": "resume", "type": "button", "layout": { "width": 240 }, "properties": { "text": "Resume" }, "actions": { "click": { "type": "closeOverlay" } } },
              { "id": "to-menu", "type": "button", "layout": { "width": 240 }, "properties": { "text": "Quit to menu" }, "actions": { "click": { "type": "emitAction", "name": "toMenu" } } }
            ]
          }
        }
      ]
    }
  }
}
