{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Plugin",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}/gradlew.bat" },
      "args": [":plugin-abyssus:runIde", "-PideProject=${workspaceFolder}/projects/app-game-control-line/project/ControlLine"],
      "isBackground": true,
      "problemMatcher": [],
      "group": "none"
    },
    {
      "label": "Run IDE for UI Tests",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}/gradlew.bat" },
      "args": ["runIdeForUiTests", "-PideProject=${workspaceFolder}/projects/app-game-control-line/project/ControlLine"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Control Line",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}/gradlew.bat" },
      "args": [":app-game-control-line:run"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}/gradlew.bat" },
      "args": ["check"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}/gradlew.bat" },
      "args": ["clean"],
      "problemMatcher": []
    },
    {
      "label": "Run Verifications",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}/gradlew.bat" },
      "args": [":plugin-abyssus:verifyPlugin"],
      "dependsOn": ["Clean"],
      "problemMatcher": []
    }
  ]
}
